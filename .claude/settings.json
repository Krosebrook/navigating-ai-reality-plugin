{
  "permissions": {
    "allow": [
      "mcp__reality_lens__reality_lens_search_tools",
      "mcp__reality_lens__reality_lens_propel_goal",
      "mcp__reality_lens__reality_lens_build_scaffold",
      "mcp__reality_lens__reality_lens_puncture_ioed",
      "mcp__reality_lens__reality_lens_break_sycophancy",
      "mcp__reality_lens__reality_lens_audit_safety",
      "mcp__reality_lens__reality_lens_horizon_radar",
      "mcp__reality_lens__reality_lens_career_and_layoff_shield",
      "mcp__reality_lens__reality_lens_scam_and_bank_run_radar",
      "mcp__reality_lens__reality_lens_brain_fry_and_family_guard",
      "mcp__reality_lens__reality_lens_ambition_and_gauntlet_builder"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Read(.env)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/user_prompt_submit.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre_tool_use_countersign.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/stop_adversarial_audit.py"
          }
        ]
      }
    ]
  }
}
