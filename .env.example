# ==============================================================================
# Reality Lens v3.0.0 — Environment Configuration (.env.example)
# ==============================================================================

# Core MCP Server & Guardrail Settings (stdio + HTTP)
REALITY_LENS_STATELESS_SPEC=2025-11
REALITY_LENS_RATE_LIMIT_RPM=60
REALITY_LENS_NOTEBOOK_CORPUS=39
REALITY_LENS_HMAC_KEY=replace-with-random-32-byte-hmac-signing-key

# Remote Streamable HTTP Settings (reality_lens_http_app.py / Docker / Render)
PORT=8000
REALITY_LENS_BEARER_TOKEN=replace-with-secret-bearer-token-for-remote-mcp
REALITY_LENS_CORS_ORIGIN=*
